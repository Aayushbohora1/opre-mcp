# OPRE environment configuration
# Copy to .env and export these in the MCP client configuration, or set them in
# your client's `env` block. Every value below is optional.

# Where project directories live (must be an absolute path).
# OPRE_HOME=/absolute/path/to/opre-projects

# --- Context safety -----------------------------------------------------------
# Hard ceiling, in characters, for a single tool response.
# OPRE_MAX_RESPONSE_CHARS=24000
# Default page size for retrieval tools.
# OPRE_MAX_ITEMS=25

# --- Research limits ----------------------------------------------------------
# OPRE_RESEARCH_MAX_PAGES=25
# OPRE_RESEARCH_MAX_DEPTH=2
# OPRE_RESEARCH_TIMEOUT_MS=30000
# OPRE_RESEARCH_MAX_LINKS=100
# OPRE_RESEARCH_VIEWPORTS=desktop:1440x900;mobile:390x844
# OPRE_RESEARCH_SCREENSHOTS=true
# OPRE_RESEARCH_HAR=false

# --- Browser ------------------------------------------------------------------
# Point at an existing Chromium if `npx playwright install` is unavailable.
# OPRE_BROWSER_EXECUTABLE=/usr/bin/chromium
# OPRE_BROWSER_HEADLESS=true

# --- Web search (optional) ----------------------------------------------------
# Without a provider OPRE returns an explicit unsupported_capability error
# instead of fabricated results.
# OPRE_WEB_SEARCH_PROVIDER=searxng
# OPRE_SEARXNG_URL=https://searx.example.com
# OPRE_SEARCH_MAX_RESULTS=8
# OPRE_SEARCH_TIMEOUT_MS=20000

# --- Network policy -----------------------------------------------------------
# Keep false unless you deliberately research a host you control.
# OPRE_ALLOW_PRIVATE_NETWORK=false
# OPRE_MAX_DOWNLOAD_BYTES=25000000

# --- Local runner / validation ------------------------------------------------
# OPRE_RUNNER_ENABLED=true
# OPRE_DEFAULT_PORT=4173
# OPRE_SERVER_START_TIMEOUT_MS=60000
# OPRE_VALIDATION_TIMEOUT_MS=30000
# OPRE_MAX_VALIDATION_ATTEMPTS=3

# --- Diagnostics (stderr only; stdout carries the MCP protocol) ---------------
# OPRE_LOG_LEVEL=error
